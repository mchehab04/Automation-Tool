# Postgres connection string (Neon or any Postgres-compatible host)
DATABASE_URL=

# Anthropic API key — used for AI email intake and AI-generated closing reports
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gmail account used to send quotes and read inbound customer emails
GMAIL_USER=

# Gmail App Password (not your regular password) — generate one at
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Shared secret the Vercel Cron job sends when it calls /api/cron/gmail-intake,
# so the endpoint can tell a real scheduled call from a random request
CRON_SECRET=

# WhatsApp Cloud API (Meta) — used for WhatsApp message intake
# https://developers.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any string you choose yourself — used only for Meta's webhook
# verification handshake (not a value Meta gives you)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
