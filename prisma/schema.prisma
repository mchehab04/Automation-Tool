// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// What kind of business this is — lets the same pipeline app support more
// than the auto-garage vertical later (house maintenance, real estate, ...)
// without a schema change. Not branched on anywhere in the code yet; this
// is prep, not a behavior change.
enum BusinessCategory {
  AUTO_GARAGE
  HOUSE_MAINTENANCE
  REAL_ESTATE
}

model Business {
  id        String           @id @default(cuid())
  name      String
  // Printed on the quote PDF, under the business name (top left).
  address   String?
  category  BusinessCategory @default(AUTO_GARAGE)
  createdAt DateTime         @default(now())

  leads        Lead[]
  catalogItems ServiceCatalogItem[]
  employees    Employee[]
}

// A staff member who can log in. Per-employee (not one shared login) so
// actions stay attributable and revoking one person's access doesn't mean
// rotating a password everyone shares. No roles/permissions yet — nothing
// in the app branches on identity today, so a role field would be pure
// speculation; add it if a real need shows up.
model Employee {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions Session[]

  @@index([businessId])
}

// Opaque session tokens — only a SHA-256 hash of the raw token is ever
// stored here, so a DB leak alone can't be used to impersonate a live
// session (the raw token only ever lives in the httpOnly cookie).
model Session {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

// Priced parts/labor entries a business offers (e.g. "Oil change" — $65),
// given to the AI email-intake extraction step as grounding context so
// suggested_line_items reuse real catalogue prices/wording instead of
// inventing them. A human still reviews every suggestion before a quote is
// sent, so imperfect AI matching against this list is an acceptable
// trade-off — no separate deterministic fuzzy-matching layer.
model ServiceCatalogItem {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id])
  description String
  // Stored in cents, matching Quote.totalAmount's convention, to avoid
  // float rounding issues.
  unitPrice   Int
  // Which business vertical this item applies to — currently always matches
  // its own business's category (a catalogue item belongs to exactly one
  // business), but tagging it explicitly here sets up future shared/
  // template catalogues without another migration.
  category    BusinessCategory @default(AUTO_GARAGE)
  createdAt   DateTime         @default(now())

  @@index([businessId])
}

enum PipelineStage {
  NEW
  QUALIFIED
  QUOTE_SENT
  // A service appointment has been booked — Won now means the service was
  // completed and the car was returned, not just that the quote was accepted.
  SCHEDULED
  // Vehicle is physically at the shop and being worked on. Sits between a
  // booked appointment and Won specifically because that gap can span days
  // and the scope of work can still change (supplementary repairs found
  // mid-job) — without this stage there was no way to represent "car's here,
  // not done yet" at all. Deliberately just the stage itself for now, not a
  // quote-revision workflow for mid-job scope changes — that's a separate,
  // larger feature.
  IN_PROGRESS
  WON
  LOST
}

enum LeadSource {
  MANUAL
  EMAIL
  WHATSAPP
}

model Lead {
  id                 String        @id @default(cuid())
  businessId         String
  business           Business      @relation(fields: [businessId], references: [id])
  name               String
  email              String?
  phone              String?
  company            String?
  source             LeadSource    @default(MANUAL)
  stage              PipelineStage @default(NEW)
  // Required to move a lead to QUALIFIED (see updateLeadStage) — "qualified"
  // means the vehicle is identified, not just that contact info exists.
  // AI intake (extractEnquiry) fills these when mentioned; the QUALIFIED
  // dialog lets staff confirm/edit or fill them in for manual leads.
  vehicleMake        String?
  vehicleModel       String?
  vehicleYear        String?
  // JSON-encoded array of { description, unitPrice } suggested by AI
  // intake, offered as a starting point for the first quote — never applied
  // without a human generating the quote themselves.
  suggestedLineItems String?
  // AI-drafted clarifying reply awaiting staff review (real intake only,
  // not the simulator) — cleared once accepted/sent via sendPendingReply.
  // Replaced, not merged, on a new message: a reply is one current draft,
  // not a list.
  pendingReplyText   String?
  // AI-drafted message to accompany a quote, populated at intake time
  // whenever nothing was missing/unclear (the complement of
  // pendingReplyText) — cleared once a quote is actually sent.
  pendingQuoteMessage String?
  // AI-drafted thank-you message awaiting staff review, populated when a
  // lead closes WON/LOST — cleared once sent via sendClosingMessage.
  pendingClosingMessage String?
  // Deterministic booking-confirmation message, populated when the lead
  // moves to SCHEDULED — cleared once sent via sendBookingMessage. Not
  // AI-drafted (unlike the other pending* fields): the appointment time and
  // vehicle are already fully known at that point, nothing to synthesize.
  pendingBookingMessage String?
  // Booked appointment time, set when the lead moves to SCHEDULED.
  scheduledAt        DateTime?
  // Set when this lead was created because the same contact (by email/phone)
  // had a prior lead that had already closed WON/LOST — links a repeat
  // customer's new engagement back to their history without reopening the
  // closed lead itself. Never set on a continued (still-open) lead.
  previousLeadId     String?
  previousLead       Lead?         @relation("LeadFollowUp", fields: [previousLeadId], references: [id], onDelete: SetNull)
  followUpLeads      Lead[]        @relation("LeadFollowUp")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  activities    Activity[]
  quotes        Quote[]
  messages      Message[]
  notifications Notification[]

  @@index([businessId])
  @@index([stage])
  @@index([previousLeadId])
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  QUOTE_GENERATED
  REPORT
}

enum MessageRole {
  CUSTOMER
  BUSINESS
}

// Raw inbound/outbound conversation text for a lead (e.g. a simulated email
// thread), kept separately from the Activity feed's human-facing summaries
// so the underlying source material stays auditable.
model Message {
  id        String      @id @default(cuid())
  leadId    String
  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  role      MessageRole
  text      String
  // A channel-specific idempotency key for real inbound messages — the RFC
  // Message-ID header for email, WhatsApp's message ID for WhatsApp — used
  // to make intake idempotent against reprocessing (e.g. an IMAP \Seen flag
  // not getting set in time). NULL for simulated messages, which have no
  // such identifier.
  externalId String?     @unique
  createdAt DateTime    @default(now())

  @@index([leadId])
}

model Activity {
  id         String       @id @default(cuid())
  leadId     String
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       ActivityType
  note       String?
  fromStage  PipelineStage?
  toStage    PipelineStage?
  reasonCode String?
  createdAt  DateTime     @default(now())

  @@index([leadId])
}

model Quote {
  id            String   @id @default(cuid())
  // Sequential, human-facing quote number (e.g. for PDF filenames/invoice
  // display) — distinct from `id`, which stays a cuid for internal use.
  number        Int?     @unique
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lineItems     String   // JSON-encoded array of { description, quantity, unitPrice }
  // Staff-authored free text (e.g. warranty terms), printed on the PDF
  // between the customer info and the line-item table when present.
  notes         String?
  // Pre-VAT subtotal — unchanged meaning. VAT (5%) and the grand total are
  // computed at PDF-render time only, never stored, so existing quotes'
  // recorded totals stay exactly what was actually quoted before VAT display
  // was added.
  totalAmount   Int      // stored in cents to avoid float rounding issues
  currency      String   @default("USD")
  generatedAt   DateTime @default(now())
  // Set once the (simulated) "send to customer" approval fires.
  sentAt        DateTime?

  @@index([leadId])
}

enum NotificationType {
  // A brand-new lead was created from an inbound message (simulated or real).
  NEW_LEAD
  // A new inbound message landed on a lead that already existed (matched by
  // email/phone) — surfaced so staff know to check in, since it's not their
  // first contact.
  NEW_MESSAGE
  // A quote was generated and is ready to be emailed to the customer.
  QUOTE_SEND_PENDING
  // Real intake drafted a clarifying reply awaiting staff review.
  REPLY_SEND_PENDING
  // A thank-you message drafted for a just-closed lead is awaiting review.
  THANK_YOU_SEND_PENDING
  // A booking-confirmation message is drafted and awaiting staff review,
  // populated when a lead moves to SCHEDULED.
  BOOKING_SEND_PENDING
}

// In-app "needs your attention" queue, shown via the header bell icon —
// keeps human-in-the-loop steps visible without staff having to babysit a
// specific page.
model Notification {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Set only for QUOTE_SEND_PENDING, so approving one quote resolves
  // precisely that notification rather than every pending one on the lead.
  quoteId   String?
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([leadId])
  @@index([read])
}
